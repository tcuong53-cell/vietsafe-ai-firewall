ENVIRONMENT=development

# Local quick start uses SQLite if DATABASE_URL is omitted.
# Production/PostgreSQL:
DATABASE_URL=postgresql+psycopg://vietsafe:vietsafe@127.0.0.1:5432/vietsafe

BOOTSTRAP_TENANT_ID=demo-insurance
BOOTSTRAP_TENANT_NAME=Demo Insurance Tenant
BOOTSTRAP_API_KEY=dev_demo_key
API_KEY_SALT=replace-with-a-long-random-secret

RATE_LIMIT_PER_MINUTE=60

# OpenAI Moderation uses /v1/moderations. The current default is omni-moderation-latest.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODERATION_MODEL=omni-moderation-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
LLAMA_GUARD_MODEL=llama-guard3

# Optional upstream router inspired by LiteLLM.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini

# Optional toxicity API.
PERSPECTIVE_API_KEY=

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# auto | underthesea | pyvi | fallback
VIETNAMESE_NLP_BACKEND=auto
